"""
degrade_images.py
=================
Generates synthetic low-resolution (LR) images from a folder of high-resolution
(HR) images using the practical radiograph degradation model of AID-SRGAN:

    Huang, Wang, Omachi. "Rethinking Degradation: Radiograph Super-Resolution
    via AID-SRGAN". MLMI @ MICCAI 2022.
    Original code: https://github.com/yongsongH/AIDSRGAN-MICCAI2022 (Apache-2.0)

This script merges the three released stages into a single command:
  1) Noise/blur stage : one of 10 random combinations of Gaussian blur,
                        motion blur and Poisson noise (case 0 = no degradation).
  2) Downsampling     : bicubic (cv2.INTER_CUBIC) by 0.5 (x2) or 0.25 (x4).
  3) Compression      : the released step 3 only re-saves a PNG (lossless).
                        Optional JPEG compression is available via --jpeg_quality
                        (NOT part of the released code; disabled by default).

Differences with respect to the released scripts (on purpose):
  - Output size is computed as (width * scale, height * scale). The released
    step 2 passes (height, width) to cv2.resize, which swaps the axes for
    non-square images.
  - Poisson noise is implemented with NumPy using the same algorithm as
    skimage.util.random_noise(mode="poisson"), so results are reproducible
    with a seed and independent of the scikit-image version.
  - Intermediate results are kept as uint8 after every operation.
  - Each image gets its own RNG seeded from (seed, filename), so the output
    does not depend on the processing order.
  - Output is always written as lossless PNG and never overwrites the input.

Outputs:
  <out_dir>/<name>.png         degraded LR image
  <out_dir>/degradation_log.csv  case and operations applied to each image

Usage:
  python degrade_images_MICCAI.py --in_dir DATASET/mammo_val --scale 0.5
  python degrade_images_MICCAI.py --in_dir DATASET/mammo_val --scale 0.25 --seed 123
  python degrade_images_MICCAI.py --in_dir ~/Downloads/mammo_test --scale 0.25 --seed 123 --jpeg_quality
  python degrade_images_MICCAI.py --in_dir DATASET/mammo_val --scale 0.25 --case 3  # Poisson only
"""

import argparse
import csv
import random
import sys
import zlib
from pathlib import Path

import cv2
import numpy as np

IMG_EXTS = {".png", ".jpg", ".jpeg", ".tif", ".tiff", ".bmp"}

# Operation sequences of the 10 random cases of the released step 1
CASES = {
    0: [],
    1: ["gblur"],
    2: ["motion"],
    3: ["poisson"],
    4: ["gblur", "motion"],
    5: ["gblur", "poisson"],
    6: ["poisson", "motion"],
    7: ["gblur", "poisson", "motion"],
    8: ["poisson", "gblur", "motion"],
    9: ["motion", "gblur", "poisson"],
}


def parse_args() -> argparse.Namespace:
    """Parses command line arguments."""
    p = argparse.ArgumentParser(description="AID-SRGAN radiograph degradation + downsampling")
    p.add_argument("--in_dir", required=True, help="Folder with the HR images")
    p.add_argument("--out_dir", default="",
                   help="Output folder (default: <in_dir>_LR_x<N>)")
    p.add_argument("--scale", type=float, required=True, choices=[0.5, 0.25],
                   help="Downsampling factor: 0.5 for x2, 0.25 for x4")
    p.add_argument("--seed", type=int, default=42)
    p.add_argument("--case", type=int, default=None, choices=sorted(CASES),
                   help="Force one degradation case (0-9) for all images. "
                        "Default: random case per image, as in the original code.")
    p.add_argument("--motion_norm", default="minmax", choices=["minmax", "kernel"],
                   help="'minmax' = original behaviour (stretch result to 0-255). "
                        "'kernel' = normalise the kernel to sum 1 and keep intensities.")
    p.add_argument("--jpeg_quality", type=int, default=None,
                   help="Optional JPEG quality (1-100) applied after downsampling. "
                        "Not part of the released code. Disabled by default.")
    p.add_argument("--keep_format", action="store_true",
               help="Save LR images with the same extension as the input (default: always PNG).")
    return p.parse_args()


# ── Degradation operators ────────────────────────────────────────────────────
def gaussian_blur(img: np.ndarray, rng: random.Random) -> np.ndarray:
    """Gaussian blur with random odd kernel sizes in {1,3,5} and sigma in [0, 1.1]."""
    k1 = rng.randint(1, 5)
    k2 = rng.randint(1, 5)
    # Kernel sizes must be odd
    if k1 % 2 == 0:
        k1 += 1
    if k2 % 2 == 0:
        k2 += 1
    sx = rng.uniform(0, 1.1)
    sy = rng.uniform(0, 1.1)
    return cv2.GaussianBlur(img, ksize=(k1, k2), sigmaX=sx, sigmaY=sy)


def motion_blur(img: np.ndarray, norm: str, degree: int = 6, angle: int = 45) -> np.ndarray:
    """Motion blur with the fixed 6x6 rotated-diagonal kernel of the original code."""
    m = cv2.getRotationMatrix2D((degree / 2, degree / 2), angle, 1)
    kernel = np.diag(np.ones(degree))
    kernel = cv2.warpAffine(kernel, m, (degree, degree))
    if norm == "kernel":
        # Keep overall intensity by making the kernel sum to 1
        kernel = kernel / kernel.sum()
        return cv2.filter2D(img, -1, kernel)
    # Original behaviour: the rotated kernel sums to ~0.72, so the result is
    # darker; the original code then stretches it to the full 0-255 range.
    kernel = kernel / degree
    blurred = cv2.filter2D(img, -1, kernel)
    return cv2.normalize(blurred, None, 0, 255, cv2.NORM_MINMAX)


def poisson_noise(img: np.ndarray, nrng: np.random.Generator) -> np.ndarray:
    """Poisson noise, same algorithm as skimage.util.random_noise(mode='poisson')."""
    x = img.astype(np.float64) / 255.0
    vals = len(np.unique(img))
    vals = 2 ** np.ceil(np.log2(vals))
    out = nrng.poisson(x * vals) / float(vals)
    return np.rint(np.clip(out, 0, 1) * 255).astype(np.uint8)


def downsample(img: np.ndarray, scale: float) -> np.ndarray:
    """Bicubic downsampling. cv2.resize expects (width, height)."""
    h, w = img.shape[:2]
    new_w = max(1, int(w * scale))
    new_h = max(1, int(h * scale))
    return cv2.resize(img, (new_w, new_h), interpolation=cv2.INTER_CUBIC)


def jpeg_compress(img: np.ndarray, quality: int) -> np.ndarray:
    """Encode/decode with JPEG to simulate lossy compression (optional extension)."""
    ok, buf = cv2.imencode(".jpg", img, [int(cv2.IMWRITE_JPEG_QUALITY), quality])
    if not ok:
        raise RuntimeError("JPEG encoding failed")
    return cv2.imdecode(buf, cv2.IMREAD_UNCHANGED)


# ── I/O helpers ──────────────────────────────────────────────────────────────
def load_uint8(path: Path) -> np.ndarray | None:
    """Reads an image keeping its channels and converts it to uint8."""
    img = cv2.imread(str(path), cv2.IMREAD_UNCHANGED)
    if img is None:
        return None
    if img.ndim == 3 and img.shape[2] == 4:
        img = img[:, :, :3]  # drop alpha channel
    if img.dtype == np.uint16:
        img = cv2.convertScaleAbs(img, alpha=255.0 / 65535.0)
    elif img.dtype != np.uint8:
        return None
    return img


def degrade(img: np.ndarray, case: int, seed: int, args: argparse.Namespace) -> np.ndarray:
    """Applies the selected sequence of operations followed by downsampling."""
    rng = random.Random(seed)
    nrng = np.random.default_rng(seed)
    for op in CASES[case]:
        if op == "gblur":
            img = gaussian_blur(img, rng)
        elif op == "motion":
            img = motion_blur(img, args.motion_norm)
        elif op == "poisson":
            img = poisson_noise(img, nrng)
    img = downsample(img, args.scale)
    if args.jpeg_quality is not None:
        img = jpeg_compress(img, args.jpeg_quality)
    return img


def main() -> None:
    args = parse_args()
    in_dir = Path(args.in_dir)
    if not in_dir.is_dir():
        sys.exit(f"Input folder not found: {in_dir}")

    inv = int(round(1 / args.scale))
    out_dir = Path(args.out_dir) if args.out_dir else in_dir.with_name(f"{in_dir.name}_LR_x{inv}")
    if out_dir.resolve() == in_dir.resolve():
        sys.exit("out_dir must differ from in_dir (the input images are never overwritten).")
    out_dir.mkdir(parents=True, exist_ok=True)

    files = sorted(p for p in in_dir.iterdir() if p.suffix.lower() in IMG_EXTS)
    print(f"[INFO] {len(files)} images | scale={args.scale} (x{inv}) | seed={args.seed}")
    print(f"[INFO] output: {out_dir}")

    log_rows = []
    skipped, not_divisible = 0, 0
    for p in files:
        img = load_uint8(p)
        if img is None:
            print(f"  ⚠ could not read (or unsupported dtype): {p.name}")
            skipped += 1
            continue

        # Per-image seed: independent of processing order
        seed = (args.seed + zlib.crc32(p.name.encode("utf-8"))) & 0xFFFFFFFF
        case = args.case if args.case is not None else random.Random(seed).randint(0, 9)

        lr = degrade(img, case, seed, args)

        h, w = img.shape[:2]
        if h % inv or w % inv:
            not_divisible += 1
        # cv2.imwrite(str(out_dir / f"{p.stem}.png"), lr, [int(cv2.IMWRITE_PNG_COMPRESSION), 3])
        ext = p.suffix.lower() if args.keep_format else ".png"
        if ext in {".jpg", ".jpeg"}:
            params = [int(cv2.IMWRITE_JPEG_QUALITY), 95]
        elif ext == ".png":
            params = [int(cv2.IMWRITE_PNG_COMPRESSION), 3]
        else:
            params = []
        cv2.imwrite(str(out_dir / f"{p.stem}{ext}"), lr, params)
        log_rows.append({
            "filename": p.name,
            "case": case,
            "ops": "+".join(CASES[case]) or "none",
            "hr_size": f"{w}x{h}",
            "lr_size": f"{lr.shape[1]}x{lr.shape[0]}",
        })

    with open(out_dir / "degradation_log.csv", "w", newline="", encoding="utf-8") as f:
        w_ = csv.DictWriter(f, fieldnames=["filename", "case", "ops", "hr_size", "lr_size"])
        w_.writeheader()
        w_.writerows(log_rows)

    print(f"[DONE] {len(log_rows)} images written | {skipped} skipped")
    if not_divisible:
        print(f"  ⚠ {not_divisible} HR images have a side not divisible by {inv}. "
              f"LR size = floor(HR / {inv}); crop the HR image to a multiple of {inv} "
              f"before computing PSNR.")


if __name__ == "__main__":
    main()
